{
  "name": "ts-rbac",
  "version": "1.0.7",
  "description": "Role-based access control for TypeScript applications. Framework and architecture independent!",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "readme": "README.md",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint \"**/*.ts\"",
