    "prepublish": "npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andiveloper/ts-rbac.git"
  },
  "keywords": [
    "rbac"
  ],
  "author": "Andreas Koeninger",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andiveloper/ts-rbac/issues"
  },
  "homepage": "https://github.com/andiveloper/ts-rbac#readme",
  "files": [
    "lib/**/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
